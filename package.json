{
  "name": "test-smells-lab",
  "version": "1.0.0",
  "description": "Projeto base para o trabalho de detecção de Test Smells.",
  "main": "src/userService.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage",
    "test:clean": "jest __tests__/userService.clean.test.js --runInBand",
    "coverage:clean": "jest __tests__/userService.clean.test.js --runInBand --coverage --collectCoverageFrom=src/userService.js --coverageDirectory=coverage/clean",
    "lint": "eslint .",
    "lint:clean": "eslint src/ __tests__/userService.clean.test.js --max-warnings=0",
    "evidence": "node scripts/coletar-evidencias.cjs final"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.2",
    "babel-jest": "^29.7.0",
    "eslint": "8.57.1",
    "eslint-plugin-jest": "28.14.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    }
  }
}
